{
  "name": "obs-stats-frog-widget",
  "version": "1.0.0",
  "description": "OBS dock with live stream stats for the main output and obs-multi-rtmp targets, via obs-websocket",
  "main": "src/index.tsx",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development webpack serve",
    "build:dev": "cross-env NODE_ENV=development webpack",
    "build:prod": "cross-env NODE_ENV=production webpack",
    "lint-fix": "eslint ./src/**/*.ts --fix & eslint ./src/**/*.tsx --fix & stylelint ./src/**/*.scss --fix",
    "lint": "npm-run-all lint:*",
    "lint:tsc": "npx tsc -p tsconfig.json --noEmit --skipLibCheck",
    "lint:src": "npx eslint ./src",
    "lint:style": "npx stylelint src/**/*.scss",
    "test": "npm-run-all lint",
    "lint:unused": "knip"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@reduxjs/toolkit": "2.13.0",
    "antd": "6.6.6",
    "classnames": "2.5.1",
    "lodash": "4.17.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-redux": "9.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.3",
    "@stylistic/eslint-plugin": "5.6.1",
    "@swc/core": "1.16.18",
    "@types/lodash": "4.17.21",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "clean-webpack-plugin": "4.0.0",
    "cross-env": "10.1.0",
    "css-loader": "7.1.2",
    "dotenv": "17.2.3",
    "eslint": "9.39.2",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-webpack-plugin": "5.0.2",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "globals": "17.0.0",
    "html-webpack-plugin": "5.6.5",
    "knip": "6.41.0",
    "mini-css-extract-plugin": "2.9.4",
    "npm-run-all": "4.1.5",
    "react-refresh": "0.19.0",
    "sass": "1.97.2",
    "sass-loader": "16.0.6",
    "style-loader": "4.0.0",
    "stylelint": "16.26.1",
    "stylelint-config-standard-scss": "16.0.0",
    "swc-loader": "0.2.7",
    "typescript": "5.9.3",
    "webpack": "5.104.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  }
}
