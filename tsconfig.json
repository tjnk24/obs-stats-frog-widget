{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["dom", "es2022"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "paths": {
            "__actions": ["./src/actions.ts"],
            "__components/*": ["./src/components/*"],
            "__i18n": ["./src/i18n"],
            "__pages/*": ["./src/pages/*"],
            "__reducers": ["./src/reducers"],
            "__reducers/*": ["./src/reducers/*"],
            "__routes": ["./src/routes.ts"],
            "__selectors/*": ["./src/selectors/*"],
            "__services/*": ["./src/services/*"],
            "__store": ["./src/store.ts"],
            "__types/*": ["./src/types/*"],
            "__utils/*": ["./src/utils/*"],
            "infrastructure/*": ["./typings/infrastructure/*"]
        }
    },
    "include": ["src", "typings"]
}
