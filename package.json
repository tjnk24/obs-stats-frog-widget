{
  "name": "obs-stats-widget",
  "version": "0.1.0",
  "description": "OBS dock with live stream stats for the main output and obs-multi-rtmp targets, via obs-websocket",
  "main": "src/index.tsx",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development webpack serve",
    "build:dev": "cross-env NODE_ENV=development webpack",
    "build:prod": "cross-env NODE_ENV=production webpack",
    "lint-fix": "eslint ./src/**/*.ts --fix & eslint ./src/**/*.tsx --fix & stylelint ./src/**/*.scss --fix",
    "lint": "npm-run-all lint:*",
    "lint:tsc": "npx tsc -p tsconfig.json --noEmit --skipLibCheck && npx tsc -p tsconfig.node.json --noEmit",
    "lint:src": "npx eslint .",
    "lint:style": "npx stylelint src/**/*.scss",
    "test": "npm-run-all lint",
    "lint:unused": "knip",
    "prepare": "husky",
    "package:release": "npm run build:prod && node scripts/packageRelease/index.ts",
    "package:installer": "npm run package:release && node scripts/buildInstaller/index.ts",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/tests/run-tests.ps1"
  },
  "engines": {
    "node": "^24 || >=26"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@reduxjs/toolkit": "2.13.0",
    "antd": "6.6.8",
    "classnames": "2.5.1",
    "i18next": "26.5.11",
    "lodash": "4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-redux": "9.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.2",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@swc/core": "1.16.20",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "clean-webpack-plugin": "4.0.0",
    "cross-env": "10.1.0",
    "css-loader": "7.1.5",
    "dotenv": "18.0.9",
    "eslint": "9.39.2",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "6.0.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "globals": "17.13.0",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "mini-css-extract-plugin": "2.10.2",
    "npm-run-all": "4.1.5",
    "react-refresh": "0.19.0",
    "sass": "1.107.0",
    "sass-loader": "17.1.0",
    "style-loader": "4.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "swc-loader": "0.2.7",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "6.0.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings 0",
    "*.scss": "stylelint"
  }
}
