{
    "compilerOptions": {
        "target": "es2022",
        "declaration": false,
        "noImplicitAny": false,
        "noImplicitReturns": false,
        "removeComments": false,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "lib": ["dom", "es2022"],
        "strict": true,
        "outDir": "./build/",
        "sourceMap": true,
        "module": "ESNext",
        "moduleResolution": "node",
        "jsx": "react-jsx",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "__actions": ["./src/actions.ts"],
            "__components/*": ["./src/components/*"],
            "__i18n": ["./src/i18n"],
            "__pages/*": ["./src/pages/*"],
            "__reducers": ["./src/reducers"],
            "__reducers/*": ["./src/reducers/*"],
            "__routes": ["./src/routes.ts"],
            "__selectors/*": ["./src/selectors/*"],
            "__services/*": ["./src/services/*"],
            "__store": ["./src/store.ts"],
            "__types/*": ["./src/types/*"],
            "__utils/*": ["./src/utils/*"],
            "infrastructure/*": ["./typings/infrastructure/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/typings/**/*.d.ts",
        "typings/**/*.d.ts"
    ],
    "compileOnSave": false,
    "exclude": ["node_modules", "build"]
}
